{
  "name": "@pepperpapa/dsh-tool-text-stats",
  "version": "0.1.0",
  "description": "DSH 工具插件示例：tsdown 构建 lib/，作为组合包安装进 profile",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "~0.2.1-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
